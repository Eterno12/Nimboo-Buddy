{
  "name": "mochi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Mochi Desktop - bichinho virtual para a área de trabalho",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:tasks": "node --test tests/tasks.test.ts tests/removal.test.ts tests/durability.test.ts",
    "test:e2e": "npm run build && node tests/e2e/tasks-ui.e2e.mjs",
    "test:e2e:focus": "npm run build && node tests/e2e/focus-ui.e2e.mjs",
    "test:e2e:settings": "npm run build && node tests/e2e/settings-ui.e2e.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
