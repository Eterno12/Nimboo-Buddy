{
  "name": "nimboo-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Nimboo Desktop - bichinho virtual para a área de trabalho",
  "author": "Nimboo",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:tasks": "node --test tests/tasks.test.ts tests/removal.test.ts tests/durability.test.ts",
    "test:e2e": "npm run build && node tests/e2e/tasks-ui.e2e.mjs",
    "test:e2e:focus": "npm run build && node tests/e2e/focus-ui.e2e.mjs",
    "test:e2e:settings": "npm run build && node tests/e2e/settings-ui.e2e.mjs",
    "test:e2e:characters": "npm run build && node tests/e2e/characters-ui.e2e.mjs",
    "test:e2e:tasks-complete": "npm run build && node tests/e2e/tasks-complete.e2e.mjs",
    "test:e2e:links": "npm run build && node tests/e2e/links-ui.e2e.mjs",
    "test:e2e:routine": "npm run build && node tests/e2e/routine-ui.e2e.mjs",
    "test:e2e:achievements": "npm run build && node tests/e2e/achievements-ui.e2e.mjs",
    "test:e2e:history": "npm run build && node tests/e2e/assistant-history.e2e.mjs",
    "build:mobile": "vite build --config mobile/vite.config.ts",
    "dev:mobile": "vite --config mobile/vite.config.ts",
    "test:e2e:mobile": "npm run build:mobile && node tests/e2e/mobile-ui.e2e.mjs",
    "test:e2e:welcome": "npm run build && node tests/e2e/welcome-ui.e2e.mjs",
    "test:e2e:media": "npm run build && node tests/e2e/media-ui.e2e.mjs",
    "test:e2e:gemini": "npm run build && node tests/e2e/gemini-ui.e2e.mjs",
    "test:e2e:wellness": "npm run build && node tests/e2e/wellness-ui.e2e.mjs",
    "test:e2e:notes": "npm run build && node tests/e2e/notes-ui.e2e.mjs",
    "test:e2e:assistant": "npm run build && node tests/e2e/assistant-ui.e2e.mjs",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.mochi.desktop",
    "productName": "Nimboo",
    "copyright": "Nimboo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nimboo",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "sql.js": "1.15.0"
  }
}
