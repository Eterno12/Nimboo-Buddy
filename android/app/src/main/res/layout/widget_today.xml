<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Hoje": mascote à esquerda, resumo e até 3 tarefas à direita. Cores fixas (claro) para ler em qualquer papel de parede. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/mascot"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/widget_mascot"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#2B2B3A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#7A7A8C"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/row0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/title0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#2B2B3A"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/due0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/done0"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/widget_done"
                android:gravity="center"
                android:text="✓"
                android:textColor="#3F9E6B"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/title1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#2B2B3A"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/due1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/done1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/widget_done"
                android:gravity="center"
                android:text="✓"
                android:textColor="#3F9E6B"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/title2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#2B2B3A"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/due2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/done2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/widget_done"
                android:gravity="center"
                android:text="✓"
                android:textColor="#3F9E6B"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
